<!-- Inverted Triple Pendulum (cart + three hinged poles)
     Extension of Gymnasium's inverted_double_pendulum with a third pole on top.

     State-Space (name/joint/parameter):
         - cart      slider      position (m)
         - pole      hinge       angle (rad)
         - pole2     hinge2      angle (rad)
         - pole3     hinge3      angle (rad)
         + matching velocities

     Actuators:
         - cart      motor       force x (N)
-->
<mujoco model="inverted_triple_pendulum">
  <compiler coordinate="local" inertiafromgeom="true"/>
  <custom>
    <numeric data="2" name="frame_skip"/>
  </custom>
  <default>
    <joint damping="0.05"/>
    <geom contype="0" friction="1 0.1 0.1" rgba="1 1 1 1"/>
  </default>
  <option gravity="0 0 -9.81" integrator="RK4" timestep="0.01"/>
  <size nstack="3000"/>

  <visual>
    <headlight ambient="0.45 0.45 0.50" diffuse="0.70 0.68 0.75" specular="0.15 0.15 0.18"/>
    <rgba haze="0.05 0.03 0.10 1"/>
    <quality shadowsize="2048" offsamples="4"/>
    <map znear="0.02"/>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <!-- Midnight-indigo sky with a violet horizon glow. -->
    <texture type="skybox" builtin="gradient"
             rgb1="0.004 0.008 0.035" rgb2="0.26 0.035 0.30"
             width="512" height="3072"/>
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.08 0.09 0.16" rgb2="0.04 0.05 0.10"
             width="512" height="512" mark="edge" markrgb="0.18 0.20 0.32"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="10 10"
              reflectance="0.12" specular="0.25" shininess="0.15"/>
  </asset>

  <worldbody>
    <light name="key" pos="2 1.5 3.5" dir="-0.35 -0.3 -1"
           diffuse="0.9 0.85 1.0" specular="0.25 0.25 0.3" castshadow="true"/>
    <light name="fill" pos="-2 0 2.2" dir="0.5 0 -0.7"
           diffuse="0.25 0.35 0.55" specular="0.05 0.08 0.12" castshadow="false"/>
    <light name="rim" pos="0 2.2 1.2" dir="0 -0.9 -0.2"
           diffuse="0.45 0.18 0.55" specular="0.08 0.04 0.10" castshadow="false"/>

    <geom name="floor" type="plane" pos="0 0 -3.0" size="40 40 0.1" material="floor_mat"/>

    <!-- Decorative, non-colliding sky details.  They live far from the
         apparatus and have contype/conaffinity disabled, so they cannot alter
         contacts, dynamics, observations, or rewards. -->
    <geom name="moon" type="sphere" pos="-2.8 1.6 2.7" size="0.22"
          rgba="0.52 0.35 0.95 1" contype="0" conaffinity="0"/>
    <geom name="star_1" type="sphere" pos="-2.0 1.8 3.15" size="0.018"
          rgba="0.75 0.88 1 1" contype="0" conaffinity="0"/>
    <geom name="star_2" type="sphere" pos="-1.2 1.8 2.45" size="0.012"
          rgba="1 0.78 0.95 1" contype="0" conaffinity="0"/>
    <geom name="star_3" type="sphere" pos="-0.25 1.8 3.45" size="0.016"
          rgba="0.65 0.9 1 1" contype="0" conaffinity="0"/>
    <geom name="star_4" type="sphere" pos="0.9 1.8 2.8" size="0.012"
          rgba="1 0.8 0.55 1" contype="0" conaffinity="0"/>
    <geom name="star_5" type="sphere" pos="1.85 1.8 3.35" size="0.02"
          rgba="0.78 0.7 1 1" contype="0" conaffinity="0"/>
    <geom name="star_6" type="sphere" pos="2.55 1.8 2.35" size="0.014"
          rgba="0.72 0.9 1 1" contype="0" conaffinity="0"/>

    <!-- Neon cyan rail -->
    <geom name="rail" type="capsule" pos="0 0 0" quat="0.707 0 0.707 0"
          size="0.018 1.05" rgba="0.15 0.85 1.0 1"/>

    <body name="cart" pos="0 0 0">
      <joint axis="1 0 0" limited="true" margin="0.01" name="slider"
             pos="0 0 0" range="-1 1" type="slide"/>
      <!-- Soft silver-lavender cart -->
      <geom name="cart" type="capsule" pos="0 0 0" quat="0.707 0 0.707 0"
            size="0.10 0.10" rgba="0.78 0.82 0.95 1"/>
      <geom name="cart_core" type="sphere" pos="0 0 0" size="0.042"
            rgba="0.55 0.40 0.95 1" contype="0" conaffinity="0"/>

      <body name="pole" pos="0 0 0">
        <joint axis="0 1 0" name="hinge" pos="0 0 0" type="hinge"/>
        <!-- Pole 1: electric cyan -->
        <geom name="cpole" type="capsule" fromto="0 0 0 0 0 0.6"
              size="0.045" rgba="0.05 0.92 0.88 1"/>
        <geom name="joint1" type="sphere" pos="0 0 0" size="0.055"
              rgba="0.95 0.95 1.0 1" contype="0" conaffinity="0"/>

        <body name="pole2" pos="0 0 0.6">
          <joint axis="0 1 0" name="hinge2" pos="0 0 0" type="hinge"/>
          <!-- Pole 2: electric violet -->
          <geom name="cpole2" type="capsule" fromto="0 0 0 0 0 0.6"
                size="0.042" rgba="0.58 0.32 1.0 1"/>
          <geom name="joint2" type="sphere" pos="0 0 0" size="0.050"
                rgba="0.95 0.95 1.0 1" contype="0" conaffinity="0"/>

          <body name="pole3" pos="0 0 0.6">
            <joint axis="0 1 0" name="hinge3" pos="0 0 0" type="hinge"/>
            <!-- Pole 3: hot magenta/rose -->
            <geom name="cpole3" type="capsule" fromto="0 0 0 0 0 0.6"
                  size="0.038" rgba="1.0 0.22 0.52 1"/>
            <geom name="joint3" type="sphere" pos="0 0 0" size="0.045"
                  rgba="0.95 0.95 1.0 1" contype="0" conaffinity="0"/>
            <!-- Free tip (used for reward / termination) + gold jewel -->
            <site name="tip" pos="0 0 0.6" size="0.01 0.01"/>
            <geom name="tip_jewel" type="sphere" pos="0 0 0.6" size="0.042"
                  rgba="1.0 0.78 0.15 1" contype="0" conaffinity="0"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="500" joint="slider" name="slide"/>
  </actuator>
</mujoco>
